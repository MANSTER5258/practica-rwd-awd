<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hardware AWD Tablet</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f4f4; color: #202b3c; }
    .encabezado { background: #0071ce; padding: 18px; text-align: center; color: white; }
    .contenedor { max-width: 1100px; margin: 0 auto; padding: 20px; }
    .filtros { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 20px; }
    .filtros select { min-width: 0; padding: 11px; border: 1px solid #ccc; border-radius: 5px; background: white; font-size: 15px; }
    .comparativa { margin-bottom: 20px; padding: 16px; background: white; border: 1px solid #e0e0e0; border-radius: 8px; }
    .comparativa h2 { margin: 0 0 4px; font-size: 18px; }
    .nota-grafica { margin: 0 0 14px; color: #697586; font-size: 12px; line-height: 1.4; }
    .leyenda { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-bottom: 14px; color: #526174; font-size: 12px; }
    .leyenda span { display: inline-flex; align-items: center; gap: 6px; }
    .muestra-color { display: inline-block; width: 9px; height: 9px; border-radius: 2px; background: #0071ce; }
    .muestra-color.secundario { background: #ffc220; }
    .fila-grafica { display: grid; grid-template-columns: 90px minmax(0, 1fr); align-items: center; gap: 10px; margin: 12px 0; }
    .etiqueta-grafica { color: #42526e; font-size: 13px; }
    .barras { display: grid; gap: 5px; }
    .barra-grafica { height: 9px; border-radius: 8px; background: #0071ce; }
    .barra-grafica.secundaria { background: #ffc220; }
    .rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .tarjeta { min-width: 0; padding: 16px; background: white; border: 1px solid #e0e0e0; border-radius: 8px; }
    .tarjeta img { display: block; width: 100%; height: 190px; margin: 0 auto 12px; object-fit: contain; }
    .nombre { min-height: 40px; }
    .tabla-specs { width: 100%; margin: 10px 0; border-collapse: collapse; font-size: 14px; }
    .tabla-specs td { padding: 6px; border: 1px solid #ddd; }
    .tabla-specs td:first-child { width: 40%; font-weight: bold; background: #f9f9f9; }
    .precio { margin: 12px 0; color: #0071ce; font-size: 22px; font-weight: bold; }
    .boton { width: 100%; padding: 11px; background: #ffc220; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; }

    @media (max-width: 600px) {
      .contenedor { padding: 14px; }
      .filtros { grid-template-columns: 1fr; gap: 8px; }
      .rejilla { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header class="encabezado">
    <h1 style="margin: 0;">Catálogo AWD (Tablet)</h1>
  </header>
  <main class="contenedor">
    <section class="filtros" aria-label="Filtros de productos">
      <select aria-label="Marca">
        <option value="">Todas las marcas</option>
        <% opcionesFiltros.marca.forEach(function(opcion) { %>
          <option value="<%= opcion %>"><%= opcion %></option>
        <% }); %>
      </select>
      <select aria-label="Memoria RAM">
        <option value="">Toda la memoria RAM</option>
        <% opcionesFiltros.ram.forEach(function(opcion) { %>
          <option value="<%= opcion %>"><%= opcion %></option>
        <% }); %>
      </select>
      <select aria-label="Procesador">
        <option value="">Todos los procesadores</option>
        <% opcionesFiltros.cpu.forEach(function(opcion) { %>
          <option value="<%= opcion %>"><%= opcion %></option>
        <% }); %>
      </select>
    </section>
    <section class="comparativa" aria-labelledby="titulo-comparativa">
      <h2 id="titulo-comparativa">Comparativa de rendimiento</h2>
      <p class="nota-grafica">Vista de muestra · valores ilustrativos</p>
      <div class="leyenda" aria-label="Leyenda del gráfico">
        <span><i class="muestra-color"></i>Equipo A</span>
        <span><i class="muestra-color secundario"></i>Equipo B</span>
      </div>
      <div role="img" aria-label="Gráfico ilustrativo que compara dos equipos en procesador, memoria RAM y gráficos">
        <div class="fila-grafica">
          <span class="etiqueta-grafica">Procesador</span>
          <div class="barras"><div class="barra-grafica" style="width: 82%;"></div><div class="barra-grafica secundaria" style="width: 64%;"></div></div>
        </div>
        <div class="fila-grafica">
          <span class="etiqueta-grafica">Memoria RAM</span>
          <div class="barras"><div class="barra-grafica" style="width: 70%;"></div><div class="barra-grafica secundaria" style="width: 88%;"></div></div>
        </div>
        <div class="fila-grafica">
          <span class="etiqueta-grafica">Gráficos</span>
          <div class="barras"><div class="barra-grafica" style="width: 58%;"></div><div class="barra-grafica secundaria" style="width: 76%;"></div></div>
        </div>
      </div>
    </section>
    <section class="rejilla" aria-label="Productos">
      <% productos.forEach(function(item) { %>
        <article class="tarjeta">
          <img src="<%= item.img %>" alt="<%= item.nombre %>">
          <div class="nombre"><strong><%= item.nombre %></strong></div>
          <table class="tabla-specs">
            <tr><td>Procesador</td><td><%= item.cpu %></td></tr>
            <tr><td>Memoria RAM</td><td><%= item.ram %></td></tr>
          </table>
          <div class="precio"><%= item.precio %></div>
          <button class="boton">Comprar</button>
        </article>
      <% }); %>
    </section>
  </main>
</body>
</html>
